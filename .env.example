# Llave secreta del ícono de la tía. Generala con: openssl rand -hex 24
TIA_TOKEN=

# Se completan solas al conectar un Blob store en Vercel (Storage → Blob):
# BLOB_STORE_ID (sistema nuevo, con OIDC) o BLOB_READ_WRITE_TOKEN (sistema viejo).
# Sin ninguna de las dos, en local se guarda todo en la carpeta .data/
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Opcional: forzar el tipo de store en vez de detectarlo (public o private).
BLOB_ACCESS=

# Opcional: número de WhatsApp de Norma con código de país (ej: 5491112345678).
# Sin esto, el botón «Escribile» abre /whatsapp, que simula el chat.
NEXT_PUBLIC_WHATSAPP_NUMERO=
